    { "ph": "f", "name": "handoff", "cat": "flow", "id": "h1", "pid": 1, "tid": 1, "ts": 50000, "bp": "e" },

    { "ph": "s", "name": "handoff", "cat": "flow", "id": "h2", "pid": 1, "tid": 1, "ts": 9500 },
